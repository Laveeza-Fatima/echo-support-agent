    "Ask owner on WhatsApp": { "main": [[{ "node": "Remember WhatsApp message id", "type": "main", "index": 0 }]] },
    "Remember WhatsApp message id": { "main": [[{ "node": "Tell the agent it worked", "type": "main", "index": 0 }]] }
